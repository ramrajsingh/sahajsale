# Copy to .env and fill in. Everything is optional: with no keys SahajSale runs in clearly labelled MOCK mode.

# --- Sarvam AI (voice): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# SARVAM_TRANSLATE_MODEL=mayura:v1
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=anushka
# SARVAM_STT_MODEL=saaras:v3

# --- Flagsmith (feature flags): create two features in one environment:
#       sale_mode                (boolean, default OFF)
#       urgency_banner_variant   (enabled, string value "A" or "B")
#     FLAGSMITH_ENV_KEY   = the environment's client-side key (used by the storefront to READ flags)
#     FLAGSMITH_ADMIN_KEY = an Admin API key (used by SahajSale to FLIP sale_mode after the owner approves)
#     Change-request workflows must be OFF on this environment, or the API write is refused.
FLAGSMITH_ENV_KEY=
FLAGSMITH_ADMIN_KEY=
# Either the project id (SahajSale looks the feature ids up) or the ids directly:
FLAGSMITH_PROJECT_ID=
# FLAGSMITH_FEATURE_IDS=sale_mode=12345,urgency_banner_variant=12346
# Self-hosted Flagsmith? Point both at your instance:
# FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1
# FLAGSMITH_ADMIN_URL=https://api.flagsmith.com/api/v1

# --- SahajSale behaviour
DEFAULT_LANG=hi-IN
AUTO_DETECT=1          # own monitor opens incidents if NudgeBee has not reported one
SLOW_MS=1200           # a checkout slower than this counts as unhealthy
DEMO_CONTROLS=1        # set 0 in anything that is not a demo
# WEBHOOK_TOKEN=change-me            # if set, NudgeBee must send it as X-Webhook-Token (or Bearer)
# NUDGEBEE_CALLBACK_TOKEN=           # sent as Bearer token when SahajSale calls the runbook's callback_url
